{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://works-in-korea.example/schema/service.schema.json",
  "title": "Works in Korea? — Service record",
  "description": "한국 온라인 서비스 1건의 측정 결과. 모든 측정값에는 측정시각/측정방법/신뢰도 3종 메타가 반드시 붙는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "url", "category", "importance", "signals"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$",
      "description": "파일명과 동일한 안정적 식별자. 한 번 정하면 바꾸지 않는다."
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ko"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ko": { "type": "string", "minLength": 1 }
      }
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "category": {
      "type": "string",
      "enum": [
        "transport",
        "ticketing",
        "shopping",
        "delivery",
        "finance",
        "telecom",
        "government",
        "healthcare",
        "accommodation",
        "culture"
      ]
    },
    "importance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "외국인 방문자·거주자 기준 우선순위. 1=필수, 3=선택"
    },
    "hints": {
      "type": "object",
      "additionalProperties": false,
      "description": "사람이 채워 넣는 측정 힌트. 비어 있어도 프로브는 동작하며, 채우면 정확도가 올라간다.",
      "properties": {
        "signup_url": { "type": ["string", "null"], "format": "uri" },
        "checkout_url": { "type": ["string", "null"], "format": "uri" },
        "support_url": { "type": ["string", "null"], "format": "uri" },
        "english_url": { "type": ["string", "null"], "format": "uri" },
        "ios_app_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+$",
          "description": "App Store 숫자 ID (trackId)"
        },
        "no_app": {
          "type": ["boolean", "null"],
          "description": "사람이 두 스토어를 직접 찾아보고 별도 앱이 없음을 확인한 경우 true. 자세한 사정은 notes 에 적는다."
        },
        "android_package": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overseas_access": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": { "enum": ["ok", "blocked", "degraded", "unknown"] }
          }
        },
        "i18n_ui": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": {
              "type": ["array", "null"],
              "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$" },
              "description": "탐지된 제공 언어 코드 배열. null = 미측정"
            }
          }
        },
        "signup_phone_auth": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": { "enum": ["required", "optional", "not_required", "unknown"] }
          }
        },
        "app_availability": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["ios_listed", "android_listed", "countries"],
              "properties": {
                "ios_listed": {
                  "type": ["boolean", "null"],
                  "description": "App Store에 앱이 등재되어 있는가. null = 앱 ID 미상 또는 조회 실패"
                },
                "android_listed": {
                  "type": ["boolean", "null"],
                  "description": "Google Play에 앱이 등재되어 있는가. null = 패키지명 미상 또는 조회 실패"
                },
                "countries": {
                  "type": "null",
                  "description": "국가별 출시 여부. 현재 측정 방법 없음 — 항상 null. 근거는 evidence.method_limitation 참조"
                }
              },
              "description": "스토어 등재 여부. 국가별 출시 여부는 공개 엔드포인트로 확인 불가라 측정하지 않는다."
            }
          }
        },
        "payment_gate": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "gateways": { "type": "array", "items": { "type": "string" } },
                "three_ds": { "type": ["boolean", "null"] }
              },
              "description": "공개 페이지에서 탐지된 PG 목록과 3DS 시그니처 여부"
            }
          }
        },
        "support_en": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": { "enum": ["yes", "no", "unknown"] }
          }
        },
        "foreign_card": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": { "enum": ["works", "fails", "mixed", "unknown"] }
          }
        },
        "foreign_phone_sms": {
          "$ref": "#/$defs/signal",
          "properties": {
            "value": { "enum": ["works", "fails", "mixed", "unknown"] }
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": ["string", "null"] },
        "ko": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "measured_at", "method", "confidence", "evidence"],
      "properties": {
        "value": {},
        "measured_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "마지막 측정 시각 (UTC, ISO 8601). null = 한 번도 측정된 적 없음"
        },
        "first_seen_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "현재 value가 처음 관측된 시각"
        },
        "last_changed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "value가 마지막으로 바뀐 시각. /changes 페이지의 근거"
        },
        "method": {
          "type": "string",
          "pattern": "^(auto:[a-z0-9_-]+|community|manual|none)$",
          "description": "auto:<프로브명> | community | manual | none(미측정)"
        },
        "confidence": {
          "type": "string",
          "enum": ["auto", "community", "conflicting", "unknown"]
        },
        "evidence": {
          "type": ["object", "null"],
          "description": "반증 가능하게 남기는 원본 근거. 프로브별로 구조가 다르다."
        }
      }
    }
  }
}
